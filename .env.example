# ==============================================================================
# textLove - Environment Variables Template
# Copy this file to .env in local environments. Never commit real credentials!
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Required in Phase 2+)
MONGODB_URI=mongodb://localhost:27017/textlove

# Authentication & Sessions (Required in Phase 3+)
SESSION_SECRET=replace_with_64_character_crypto_random_secret_in_production
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Media Storage (Cloudinary - Required in Phase 3+)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1
